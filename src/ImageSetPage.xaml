<UserControl x:Class="Ninjins_EDDS_ImageSet_Toolkit.ImageSetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ninjins_EDDS_ImageSet_Toolkit"
             AllowDrop="True"
             Drop="OnPageDrop"
             DragOver="OnPageDragOver">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Canvas"/>
                        <ComboBox x:Name="CanvasBox" Width="120" SelectionChanged="OnGridChanged">
                            <ComboBoxItem Content="256" Tag="256"/>
                            <ComboBoxItem Content="512" Tag="512"/>
                            <ComboBoxItem Content="1024" Tag="1024" IsSelected="True"/>
                            <ComboBoxItem Content="2048" Tag="2048"/>
                            <ComboBoxItem Content="4096" Tag="4096"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Cell"/>
                        <ComboBox x:Name="CellBox" Width="120" SelectionChanged="OnGridChanged">
                            <ComboBoxItem Content="64" Tag="64"/>
                            <ComboBoxItem Content="128" Tag="128"/>
                            <ComboBoxItem Content="256" Tag="256" IsSelected="True"/>
                            <ComboBoxItem Content="512" Tag="512"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label x:Name="InsetLabel" Content="Icon inset  16 px"/>
                        <Slider x:Name="InsetSlider" Width="160" Minimum="0" Maximum="64" Value="16" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,8,0,0" ValueChanged="OnInsetChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock x:Name="GridLabel" Text="4 x 4 cells, 256 px each" FontWeight="SemiBold"/>
                        <TextBlock Text="Drop a folder of PNGs to size the grid and place every icon. Click a cell to replace one." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource LogBgBrush}" ClipToBounds="True" AllowDrop="True" Drop="OnBoardDrop" DragOver="OnPageDragOver">
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="{StaticResource CheckDarkBrush}" Geometry="M0,0 H16 V16 H0 Z"/>
                                        <GeometryDrawing Brush="{StaticResource CheckLiteBrush}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Viewbox Margin="16" Stretch="Uniform">
                        <Border x:Name="BoardFrame" Width="800" Height="800" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <UniformGrid x:Name="CellBoard"/>
                        </Border>
                    </Viewbox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Imageset" Style="{StaticResource PanelHeading}" Margin="0,0,0,8"/>
                    <Label Content="Set name"/>
                    <TextBox x:Name="SetNameBox" Text="items" TextChanged="OnSnippetFieldsChanged"/>
                    <Label Content="Texture path in the .imageset" Margin="0,10,0,0"/>
                    <TextBox x:Name="TexturePathBox" Text="Ninjins_Core/gui/imagesets" TextChanged="OnSnippetFieldsChanged"/>
                    <TextBlock Text="Must match the folder you copy the files into. Paste class imageSets into Ninjins_Core/config.cpp under CfgMods > defs, next to gameScriptModule."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <CheckBox x:Name="WhiteOverlayBox" Content="Color overlay white (keep alpha)" Margin="0,12,0,0" Checked="OnWhiteOverlayChanged" Unchecked="OnWhiteOverlayChanged"/>
                    <TextBlock Text="Photoshop Layer Style > Color Overlay > white. Use this for slot / HUD icons the game tints."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Label Content="Selected cell name" Margin="0,14,0,0"/>
                    <TextBox x:Name="CellNameBox" TextChanged="OnCellNameChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Browse PNG" Style="{StaticResource GhostButton}" Click="OnBrowseCell" Margin="0,0,8,0"/>
                        <Button Content="Clear cell" Style="{StaticResource GhostButton}" Click="OnClearCell"/>
                    </StackPanel>

                    <Label Content="Quads" Margin="0,14,0,0"/>
                    <ListBox x:Name="QuadList" MaxHeight="180" SelectionChanged="OnQuadListChanged" DisplayMemberPath="Caption"/>

                    <Button Content="Load folder of PNGs" Style="{StaticResource AddButton}" Margin="0,10,0,0" Click="OnFillFolder"/>
                    <Button Content="Load Photoshop sheet PNG" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnLoadSheet"/>
                    <Button Content="Clear grid" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnClearGrid"/>

                    <Label Content="Output folder" Margin="0,14,0,0"/>
                    <TextBox x:Name="OutputFolderBox"/>
                    <Button Content="Browse output folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnBrowseOutput"/>
                    <CheckBox x:Name="OverwriteBox" Content="Overwrite existing files" IsChecked="True"/>
                    <CheckBox x:Name="OpenFolderBox" Content="Open output folder when done"/>

                    <Button x:Name="WriteButton" Content="Write imageset + EDDS" Style="{StaticResource AccentButton}" Margin="0,16,0,0" Click="OnWrite"/>
                    <TextBlock x:Name="StatusLabel" Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Drop icons onto the grid, name the cells, then write."/>
                    <local:CppSnippetView x:Name="CppView" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
