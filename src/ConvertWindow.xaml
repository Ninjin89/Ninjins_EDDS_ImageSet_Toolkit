<Window x:Class="Ninjins_EDDS_ImageSet_Toolkit.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ninjins_EDDS_ImageSet_Toolkit"
        Title="Ninjins EDDS &amp; Imageset Toolkit"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="840" Width="1280"
        MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource StudioTopBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/app.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Ninjins EDDS &amp; Imageset Toolkit" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SubtitleBlock" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,16,0"
                           Text="EDDS to PNG, PNG to EDDS. Drag files or folders in. Imageset builds a Workbench grid."/>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="PagePill" Text="PNG / EDDS" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource StudioSideBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="TOOLS" Style="{StaticResource SideGroup}"/>
                        <Button x:Name="NavConvert" Content="PNG / EDDS" Style="{StaticResource SideNavButton}" Tag="Active" Click="OnNavConvert"/>
                        <Button x:Name="NavImageSet" Content="Imageset" Style="{StaticResource SideNavButton}" Click="OnNavImageSet"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Author: Ninjin. Docs: wiki.ninjin.org" Style="{StaticResource MutedText}" FontSize="10" Margin="8,8,8,4"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="14">
                <Grid x:Name="ConvertPage">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" MouseLeftButtonUp="OnDropZoneClick">
                            <Grid>
                                <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource AccentDimBrush}" StrokeThickness="1" StrokeDashArray="5 4" Fill="Transparent"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="EDDS to PNG, and PNG to EDDS" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Drop EDDS, DDS, PNG, TGA, BMP or TIFF. Folders are scanned recursively." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Add files" Style="{StaticResource AddButton}" Click="OnAddFiles" Margin="0,0,8,0"/>
                                        <Button Content="Add folder" Style="{StaticResource GhostButton}" Click="OnAddFolder"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                            <ListView x:Name="FileList" ItemsSource="{Binding}" SelectionChanged="OnSelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="File" Width="220" DisplayMemberBinding="{Binding SourceName}"/>
                                        <GridViewColumn Header="Direction" Width="90" DisplayMemberBinding="{Binding Direction}"/>
                                        <GridViewColumn Header="Output" Width="220" DisplayMemberBinding="{Binding OutputName}"/>
                                        <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}"/>
                                        <GridViewColumn Header="Detail" Width="260" DisplayMemberBinding="{Binding Detail}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource LogBgBrush}" CornerRadius="10,0,0,10" ClipToBounds="True">
                                    <Grid>
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="{StaticResource CheckDarkBrush}" Geometry="M0,0 H16 V16 H0 Z"/>
                                                            <GeometryDrawing Brush="{StaticResource CheckLiteBrush}" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10"/>
                                        <TextBlock x:Name="PreviewHint" Text="Select a file to preview" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBox Grid.Column="1" x:Name="LogBox" Style="{StaticResource LogText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="PNG / EDDS" Style="{StaticResource PanelHeading}" Margin="0,0,0,6"/>
                                <TextBlock Text="EDDS and DDS become PNG. PNG, TGA, BMP, TIFF become EDDS. Settings below apply only when writing EDDS." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <TextBlock Text="When writing EDDS" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Label Content="Preset"/>
                                <ComboBox x:Name="PresetBox" SelectionChanged="OnPresetChanged">
                                    <ComboBoxItem Content="UI / icons (BGRA8, 1 mip)" IsSelected="True"/>
                                    <ComboBoxItem Content="Opaque texture (DXT1, full mips)"/>
                                    <ComboBoxItem Content="Transparent texture (DXT5, full mips)"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>

                                <Label Content="Pixel format" Margin="0,12,0,0"/>
                                <ComboBox x:Name="FormatBox" SelectionChanged="OnCustomChanged">
                                    <ComboBoxItem Content="BGRA8 - UI, lossless alpha" Tag="Bgra8" IsSelected="True"/>
                                    <ComboBoxItem Content="DXT1 - opaque, small" Tag="Dxt1"/>
                                    <ComboBoxItem Content="DXT5 - compressed alpha" Tag="Dxt5"/>
                                </ComboBox>

                                <Label Content="Mipmaps" Margin="0,12,0,0"/>
                                <ComboBox x:Name="MipBox" SelectionChanged="OnCustomChanged">
                                    <ComboBoxItem Content="1 - base image only" Tag="1" IsSelected="True"/>
                                    <ComboBoxItem Content="Full chain down to 1x1" Tag="0"/>
                                    <ComboBoxItem Content="2 levels" Tag="2"/>
                                    <ComboBoxItem Content="4 levels" Tag="4"/>
                                </ComboBox>

                                <Label Content="EDDS blocks" Margin="0,12,0,0"/>
                                <ComboBox x:Name="StoreBox">
                                    <ComboBoxItem Content="LZ4 (DayZ default)" Tag="Lz4" IsSelected="True"/>
                                    <ComboBoxItem Content="Uncompressed COPY" Tag="Copy"/>
                                </ComboBox>

                                <Label x:Name="QualityLabel" Content="DXT quality  8" Margin="0,12,0,0"/>
                                <Slider x:Name="QualitySlider" Minimum="0" Maximum="10" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnQualityChanged"/>

                                <Label Content="Output folder" Margin="0,14,0,0"/>
                                <TextBox x:Name="OutputFolderBox" TextChanged="OnOutputFolderChanged"/>
                                <Button Content="Browse output folder" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnBrowseOutput"/>
                                <CheckBox x:Name="OverwriteBox" Content="Overwrite existing files" IsChecked="True"/>
                                <CheckBox x:Name="OpenFolderBox" Content="Open output folder when done"/>

                                <Button x:Name="ConvertButton" Content="Convert" Style="{StaticResource AccentButton}" Margin="0,18,0,0" Click="OnConvert"/>
                                <Button Content="Clear list" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="OnClear"/>
                                <ProgressBar x:Name="Progress" Margin="0,14,0,0" Minimum="0" Maximum="1"/>
                                <TextBlock x:Name="ProgressLabel" Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Drop files to begin."/>
                                <local:CppSnippetView x:Name="ConvertHelp" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <local:ImageSetPage x:Name="ImageSetView" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource StudioSideBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <TextBlock x:Name="StatusHint" Text="Idle" Style="{StaticResource MutedText}" FontSize="11"/>
                <TextBlock Text="wiki.ninjin.org" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
